[Unit]
Description=My Safe Coraza/OWASP CRS security gateway
Documentation=https://github.com/HCRXchenghong/my-safe
After=network-online.target my-safe-agent.service
Wants=network-online.target my-safe-agent.service

[Service]
Type=simple
User=my-safe-gateway
Group=my-safe-gateway
SupplementaryGroups=my-safe
EnvironmentFile=/etc/my-safe/gateway.env
ExecStart=/usr/local/bin/mysafe-gateway
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
StateDirectory=my-safe-gateway
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
