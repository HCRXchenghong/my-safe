[Unit]
Description=My Safe headless control plane
Documentation=https://github.com/HCRXchenghong/my-safe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=my-safe-control
Group=my-safe-control
EnvironmentFile=/etc/my-safe/control.env
ExecStart=/usr/local/bin/mysafe-control
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
StateDirectory=my-safe-control
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
