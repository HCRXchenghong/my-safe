MYSAFE_ADDRESS=:8080
MYSAFE_STORE=postgres
MYSAFE_DATABASE_DSN=postgres://mysafe:replace-me@127.0.0.1:5432/mysafe?sslmode=verify-full
MYSAFE_BOOTSTRAP_TOKEN=replace-with-a-short-lived-random-token
MYSAFE_ADMIN_TOKEN=replace-with-an-independent-random-token
MYSAFE_TLS_CERT=/etc/my-safe/tls/control-fullchain.pem
MYSAFE_TLS_KEY=/etc/my-safe/tls/control-key.pem
MYSAFE_AGENT_CA_DIR=/var/lib/my-safe-control/agent-ca
MYSAFE_REQUIRE_AGENT_MTLS=true
